/*
    Windows version resource for BreakbeatNative.

    Hand-written on purpose. JUCE normally generates this file with its
    juceaide tool, but on the build machine juceaide.exe crashes at startup
    (0xC0000005) because the MSI / Sonic-Studio audio overlay injects
    NahimicOSD.dll into processes that load dxgi/user32. See the juceaide
    bypass note in native/CMakeLists.txt.

    Keep the version numbers in step with project(BreakbeatNative VERSION ...)
    in native/CMakeLists.txt.
*/

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Arthur DnB"
            VALUE "FileDescription", "Breakbeat Pattern Maker"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "BreakbeatNative"
            VALUE "OriginalFilename", "Breakbeat Pattern Maker.exe"
            VALUE "ProductName", "Breakbeat Pattern Maker"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
