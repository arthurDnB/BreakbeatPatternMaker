{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://breakbeat-pattern-maker.local/schemas/bbpattern-v1.schema.json",
  "title": "Breakbeat Pattern Transfer v1",
  "description": "Application-owned JSON format. Not an official Renoise clipboard or file format. Lua additionally validates references, uniqueness, UTF-8 byte limits, and length arithmetic.",
  "type": "object", "additionalProperties": false,
  "required": ["format","version","engineVersion","name","genre","seed","timing","sources","lanes","notes","warnings"],
  "properties": {
    "format": {"const":"breakbeat-pattern"}, "version":{"const":1},
    "engineVersion":{"type":"string","minLength":1,"maxLength":32},
    "name":{"type":"string","minLength":1,"maxLength":120},
    "genre":{"enum":["jungle","dnb","hiphop","trap","rap","drill","breakcore","idm","hardcore","experimental","breaks","bigbeat","nuskoolbreaks","electrobreaks","breakbeathardcore","raggajungle","atmosphericjungle","footworkjungle","downtempo","lofihiphop","boombap","mellowbeats","liquiddnb","jumpup","garage","speedgarage","twostepgarage","dub","psydub","dubstep","brostep","postdubstep","drumfunk","amenscience","atmosphericbreakcore","triphop","halftimednb","neurofunk"]},
    "seed":{"type":"string","minLength":1,"maxLength":80},
    "timing": {
      "type":"object","additionalProperties":false,
      "required":["bpm","lpb","tpl","bars","beatsPerBar","lines"],
      "properties":{
        "bpm":{"type":"number","minimum":32,"maximum":999},
        "lpb":{"type":"integer","minimum":1,"maximum":32},
        "tpl":{"type":"integer","minimum":1,"maximum":16},
        "bars":{"type":"integer","minimum":1,"maximum":4},
        "beatsPerBar":{"const":4},
        "lines":{"type":"integer","minimum":1,"maximum":512}
      }
    },
    "sources":{"type":"array","minItems":1,"maxItems":32,"items":{
      "type":"object","additionalProperties":false,"required":["id","role","kind","label","note","instrument"],
      "properties":{
        "id":{"$ref":"#/definitions/id"},"role":{"$ref":"#/definitions/role"},
        "kind":{"enum":["oneShot","slice"]},"label":{"type":"string","minLength":1,"maxLength":80},
        "note":{"type":"integer","minimum":0,"maximum":119},
        "instrument":{"type":"integer","minimum":0,"maximum":254}
      }
    }},
    "lanes":{"type":"array","minItems":1,"maxItems":4,"items":{
      "type":"object","additionalProperties":false,"required":["id","name","columns"],
      "properties":{"id":{"$ref":"#/definitions/role"},"name":{"type":"string","minLength":1,"maxLength":80},"columns":{"type":"integer","minimum":1,"maximum":12}}
    }},
    "notes":{"type":"array","minItems":1,"maxItems":4096,"items":{
      "type":"object","additionalProperties":false,"required":["id","lane","source","row","column","volume","pan","delay"],
      "properties":{
        "id":{"$ref":"#/definitions/id"},"lane":{"$ref":"#/definitions/role"},"source":{"$ref":"#/definitions/id"},
        "row":{"type":"integer","minimum":0,"maximum":511},
        "column":{"type":"integer","minimum":0,"maximum":11},
        "volume":{"type":"integer","minimum":0,"maximum":128},
        "pan":{"type":"integer","minimum":0,"maximum":128},
        "delay":{"type":"integer","minimum":0,"maximum":255}
      }
    }},
    "warnings":{"type":"array","maxItems":4096,"items":{"type":"string","minLength":1,"maxLength":240}}
  },
  "definitions":{
    "id":{"type":"string","pattern":"^[a-zA-Z0-9._-]{1,80}$"},
    "role":{"enum":["kick","snare","hat","percussion"]}
  }
}
