{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true,
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "sourceMap": true, "skipLibCheck": true, "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"]
}
